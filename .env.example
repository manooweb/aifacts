# Copier en .env (jamais versionné) et adapter.

# local ou production
APP_ENV=local

# URL publique du site, sans / final. Seuls les envois venant de cette origine sont acceptés.
# Local : http://localhost:8000 · Production : https://aifacts.fr
APP_URL=http://localhost:8000

# Adresse qui reçoit une notification à chaque proposition (vide = pas d'e-mail)
NOTIFY_EMAIL=
# Expéditeur des notifications
MAIL_FROM=no-reply@aifacts.fr

# Dossier des données non versionnées : propositions.jsonl, liens.json (liens courts) ; vide = data/ à la racine du dépôt
DATA_DIR=
